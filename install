#!/bin/bash

# Declare logging
log=/tmp/profile_install.log

function spinner() {
  sym=( '|' '/' '-' '\' )
  $@ &>> /tmp/spinner.log &
  pid=$!

  idx=0
  while [ -d /proc/$pid ]
  do
    echo -e "\033[0A\033[0K ${sym[$idx]}"
    sleep 0.3
    idx=$((($idx + 1) % 3 ))
  done
  echo -ne "\033[1A\033[0K\033[1A\033[0K"
}

function rclear() {
  echo -ne "\033[0K$1"
}

function out-percent() {
  lines=`wc $log|awk '{print $1}'`
  echo "scale = 4 ; $lines / 180 * 100"|bc|awk -F'\.' '{print $1}' 2>/dev/null
}

exec 3>&1
trap 'exec 3>&1 4>&2' 0 1 2 3
exec 1>>$log

ARCH=`uname -a|awk '{print $(NF - 1)}'`
DISTRO=`cat /etc/*{release,version} 2>/dev/null|grep '^ID='|sed -e 's/ID=//g'`
XH=$HOME/.local/etc/xdg
XP=$HOME/.local/etc/profile.d

# Use sudo to install dependencies unless already root
[[ $UID == 0 ]]           \
  && ( export sudo= )     \
  || ( export sudo='sudo' )

# Assign the correct package-manager command
case "$DISTRO" in
  arch|archarm)
    export DEPS=( bc eza git gnupg openssh the_silver_searcher )
    export UPDATE="$sudo pacman -Sy"
    export INSTALL="$sudo pacman -S --noconfirm"
    ;;
  debian|ubuntu)
    export DEPS=( bc bzip2 exa git gnupg silversearcher-ag ssh )
    export UPDATE="$sudo apt update"
    export INSTALL="$sudo apt install -y"
    ;;
  *)
    echo "$DISTRO not yet supported"
    exit 1
    ;;
esac

# rclear '10%' >&3
spinner $UPDATE
# rclear '13%' >&3
spinner $INSTALL ${DEPS[@]}

# Display Progress # TODO Come back to this...
# while [[ $(out-percent) -lt 100 ]]
# do
#   rclear "`out-percent`%" >&3
#   sleep 0.1
# done & 

# Create the user-directories for installing profile.d
mkdir -vp $HOME/.local/{bin,etc/profile.d,opt,xdg}

# Download profile.d
git clone https://github.com/asdf-vm/asdf --depth 1 $HOME/.local/opt/asdf 2>>$log
git clone https://github.com/briskbear/profile.d --branch dev $XP 2>>$log || exit 1
git clone https://github.com/deftclaw/nvim $XH/nvim 2>>$log

# AutoTrust
for profile in `ls $XP/*.sh`
do
  sed -i -e "s/ : $/ : `date -u +%s`/g" "$profile"
done

# Extract appropriate binaries
tar -xf $XP/C/${ARCH}.tbz2 -C ~/.local/bin

# backup and copy .profile
mv $HOME/.profile $XP/profile.bak 2>/dev/null
ln -s $XP/profile $HOME/.profile

echo 'DONE!' | tee -a $log
# rclear '100%\n'
